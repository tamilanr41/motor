NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5174
PUBLIC_SITE_URL=http://localhost:5174
# Optional extra allowed CORS origins, comma separated
CORS_ORIGINS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lakshmi_agency
DB_USER=your_mysql_user
DB_PASSWORD=replace_me
# Set true for hosted MySQL providers that require TLS
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=8h
CUSTOMER_JWT_EXPIRES_IN=24h
# Optional: enables secret-protected self-registration from the customer sign-in screen
ADMIN_REGISTRATION_SECRET=replace_with_a_long_random_secret
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
# Optional quote notification email (SMTP). Enquiries are stored even when unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ENQUIRY_NOTIFY_EMAIL=chennailakshmiagency@gmail.com
